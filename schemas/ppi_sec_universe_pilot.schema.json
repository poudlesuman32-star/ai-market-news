{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/poudlesuman32-star/ai-market-news/schemas/ppi_sec_universe_pilot.schema.json",
  "title": "PPI SEC 500-candidate universe pilot",
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "cik",
        "company_name",
        "ticker",
        "exchange",
        "identity_status",
        "classification_status",
        "source_id",
        "source_row_sha256"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^ppi-sec-seed-[a-f0-9]{24}$"},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "company_name": {"type": "string", "minLength": 1},
        "ticker": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,14}$"},
        "exchange": {"type": "string", "enum": ["NYSE", "NASDAQ", "NYSE_AMERICAN"]},
        "identity_status": {"const": "provisional_sec_seed"},
        "classification_status": {"const": "unresolved"},
        "source_id": {"const": "sec_company_tickers_exchange"},
        "source_row_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_id",
        "snapshot_id",
        "generated_at_utc",
        "source_url",
        "source_payload_sha256",
        "source_bytes",
        "source_row_count",
        "normalized_eligible_count",
        "candidate_count",
        "candidate_limit",
        "selection_algorithm",
        "snapshot_sha256",
        "manifest_core_sha256",
        "exclusion_counts",
        "source_http"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "contract_id": {"const": "PPI-SEC-UNIVERSE-PILOT-001-R1"},
        "snapshot_id": {"type": "string", "pattern": "^ppi-sec-universe-pilot-[a-f0-9]{16}$"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "source_url": {"const": "https://www.sec.gov/files/company_tickers_exchange.json"},
        "source_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_bytes": {"type": "integer", "minimum": 1, "maximum": 20000000},
        "source_row_count": {"type": "integer", "minimum": 1},
        "normalized_eligible_count": {"type": "integer", "minimum": 500},
        "candidate_count": {"const": 500},
        "candidate_limit": {"const": 500},
        "selection_algorithm": {"const": "sha256_rank_v1"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifest_core_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exclusion_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "source_http": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "content_type", "content_encoding", "etag", "last_modified"],
          "properties": {
            "status": {"const": 200},
            "content_type": {"type": ["string", "null"]},
            "content_encoding": {"type": ["string", "null"]},
            "etag": {"type": ["string", "null"]},
            "last_modified": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
